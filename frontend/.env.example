# Copy to .env.local for development. On AWS Amplify set these under Hosting > Environment variables.
NEXT_PUBLIC_SITE_URL=https://www.sustunecare.com
# Where Next.js forwards /api/* (the FastAPI service). Server-side only.
API_URL=http://localhost:8000
# Optional: CDN or YouTube/Vimeo URL for the videos. Leave empty to use /intro.mp4, /sparsh.mp4 and /aegis.mp4 from frontend/public/.
NEXT_PUBLIC_INTRO_VIDEO_URL=
NEXT_PUBLIC_STORY_VIDEO_URL=
NEXT_PUBLIC_AEGIS_VIDEO_URL=
# Set to "false" to hide the illustrative sample figures and testimonials on the home page.
NEXT_PUBLIC_SHOW_SAMPLE_PROOF=true