# development | production. In production the API refuses to start with a weak SECRET_KEY or admin password.
ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_EMAIL=admin@sustunecare.com
ADMIN_PASSWORD=
# Switch to Postgres for production, e.g. postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./sustune.db
CORS_ORIGINS=http://localhost:3000
# optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=contact@sustunecare.com
# optional WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NOTIFY_TO=
